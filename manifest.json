{
  "manifest_version": 3,
  "name": "IG Continuity PiP",
  "version": "3.0",
  "description": "Seamless Apple-style PiP for Instagram that stays fullscreen.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",          
    "system.display"    
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://*.instagram.com/*"]
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}